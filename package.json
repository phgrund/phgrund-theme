{
  "name": "ion-city",
  "displayName": "Ion City",
  "description": "A crisp dark VS Code theme with deep blue city-night surfaces, electric cyan accents, and readable syntax contrast.",
  "version": "1.0.0",
  "publisher": "phgrund",
  "author": "phgrund",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phgrund/ion-city-theme.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "cyan",
    "ion",
    "city"
  ],
  "galleryBanner": {
    "color": "#040B15",
    "theme": "dark"
  },
  "scripts": {
    "package": "vsce package --yarn --no-dependencies",
    "publish": "vsce publish --yarn --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Ion City",
        "uiTheme": "vs-dark",
        "path": "./themes/ion-city-color-theme.json"
      }
    ]
  }
}
